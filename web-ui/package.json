{
  "name": "miroir-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "react-dsfr copy-static-assets && react-dsfr optimize-css",
    "dev": "vite",
    "prebuild": "react-dsfr copy-static-assets && react-dsfr optimize-css",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.36.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "react-dsfr": {
    "additionalComponents": [
      "breadcrumb",
      "table",
      "callout",
      "footer",
      "skiplink",
      "badge",
      "button",
      "link",
      "notice",
      "modal",
      "display",
      "header"
    ]
  }
}
