# Copy to .env and edit. Read by miroir.config (prefix MIROIR_).

# Where builds, downloaded images and indexes go. Never inside the repo.
MIROIR_DATA_DIR=~/miroir-data

# POP exports: <dir>/{joconde,memoire,rose-valand}/<name>.jsonl. Read only.
MIROIR_EXPORTS_DIR=~/miroir-exports

# Remote model work. Never commit values.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=

# Scaleway (GPU machines, Object Storage): the scw CLI's own names. Never commit values.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_REGION=fr-par
SCW_DEFAULT_ZONE=fr-par-2
